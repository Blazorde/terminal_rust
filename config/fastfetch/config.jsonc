{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": {
    "thread": true,
    "processingTimeout": 3000
  },
  "logo": {
    "type": "small",
    "padding": {
      "right": 3
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "System",
      "keyColor": "cyan"
    },
    {
      "type": "host",
      "key": "Machine",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "green"
    },
    {
      "type": "cpuusage",
      "key": "CPU load",
      "keyColor": "green",
      "percent": {
        "type": 3,
        "green": 50,
        "yellow": 80
      }
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "yellow",
      "percent": {
        "type": 3,
        "green": 50,
        "yellow": 80
      }
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "magenta",
      "percent": {
        "type": 3,
        "green": 60,
        "yellow": 85
      }
    },
    {
      "type": "localip",
      "key": "Network",
      "keyColor": "magenta"
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "red"
    },
    "break",
    "colors"
  ]
}
