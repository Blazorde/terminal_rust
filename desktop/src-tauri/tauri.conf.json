{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Rust",
  "version": "1.0.0-alpha.1",
  "identifier": "dev.terminal-rust.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Terminal Rust",
        "width": 1280,
        "height": 800,
        "minWidth": 560,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Blazorde",
    "homepage": "https://github.com/Blazorde/terminal_rust",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "A cross-platform terminal powered by a Rust shell engine.",
    "longDescription": "Terminal Rust combines a native Rust shell engine with a configurable desktop terminal for Windows, macOS and Linux.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../config/": "config/"
    }
  }
}
